+/// Whether a market provider keeps trades only for the markets it is asked to serve.
+///
+/// Off, a provider retains every trade of its exchange (`subscribe_all_trades`), which is what
+/// the desktop's screener and instant chart opens need and costs gigabytes. On, it retains the
+/// served markets alone (`subscribe_trades_for`): a host that draws a few charts and no screener.
+static SCOPED_TRADES: AtomicBool = AtomicBool::new(false);
+
+/// Choose between exchange-wide and per-market trade retention. Process-wide; set it before the
+/// sessions start, since a client applies its role when the role changes.
+pub fn set_scoped_trades(on: bool) {
+    SCOPED_TRADES.store(on, Ordering::Release);
+}
+
+/// Whether providers retain trades for their served markets only.
+pub fn scoped_trades() -> bool {
+    SCOPED_TRADES.load(Ordering::Acquire)
+}
