+/// Applies a provider role that retains trades for `markets` alone.
+///
+/// An empty list unsubscribes: to MoonProto an empty `subscribe_trades_for` means every market.
+fn apply_scoped_trades(client: &MoonClient, server_id: u64, provider: bool, markets: &[String]) {
+    if provider && !markets.is_empty() {
+        let _ = client.streams().subscribe_trades_for(
+            TradesStreamMode::TradesOnly,
+            markets.iter().map(String::as_str),
+        );
+        log::info!(
+            "core {} -> market provider (trades for {} markets)",
+            crate::feed::core_label(server_id),
+            markets.len()
+        );
+    } else {
+        let _ = client.streams().unsubscribe_all_trades();
+        log::info!(
+            "core {} -> no trade stream",
+            crate::feed::core_label(server_id)
+        );
+    }
+}
