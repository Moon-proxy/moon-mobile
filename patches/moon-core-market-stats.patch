+    /// Ask `core`'s server for its markets table: the volumes and deltas it calculates for every
+    /// market, without subscribing to any. The answer lands on the market handles later.
+    ///
+    /// Returns:
+    ///     Whether the request was queued.
+    pub fn refresh_market_stats(&self, core: CoreId) -> bool {
+        self.core_client(core)
+            .is_some_and(|client| client.markets().refresh_stats().is_ok())
+    }
+
+    /// The markets table of `core` as last received, by exchange-native market name. Markets
+    /// with no figures yet are left out; empty until a refresh was answered.
+    pub fn market_stats(&self, core: CoreId) -> Vec<(String, moonproto::MarketStats)> {
+        let Some(client) = self.core_client(core) else {
+            return Vec::new();
+        };
+        let Some(snapshot) = client.snapshot_versioned() else {
+            return Vec::new();
+        };
+        snapshot
+            .markets()
+            .iter()
+            .filter_map(|handle| handle.stats().map(|stats| (handle.name().to_string(), stats)))
+            .collect()
+    }
