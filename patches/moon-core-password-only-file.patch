+/// Start a new `servers.enc` that opens by its password alone: a fresh file key with a password
+/// slot and no machine slot, for a host with no OS keyring (the phone). Nothing is written here:
+/// the next config save writes the file.
+///
+/// Runs Argon2id. Refused while a file is open or sealed, so an existing file is never replaced.
+pub fn create_with_password(password: &str) -> Result<(), AccessError> {
+    let mut vault = vault();
+    if !matches!(&*vault, Vault::Unopened) {
+        return Err(AccessError::Backend("a servers.enc is already open".into()));
+    }
+    let key = wrap::new_file_key().map_err(|e| AccessError::Backend(e.to_string()))?;
+    let slot = wrap::password_slot(&key, password).map_err(|e| AccessError::Backend(e.to_string()))?;
+    let mut header = Header::new();
+    header.set_password_slot(Some(slot));
+    *vault = Vault::Open(Material {
+        key,
+        header,
+        needs_rewrite: true,
+    });
+    Ok(())
+}
+
